# Aplicación
NODE_ENV=development

# Backend
BACKEND_PORT=3000

# Frontend
FRONTEND_PORT=5173

# PostgreSQL
POSTGRES_DB=gerenciamiento_viajes
POSTGRES_USER=viajes_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD
POSTGRES_PORT=5433

# Conexión del backend
DATABASE_URL=postgresql://viajes_user:CAMBIAR_PASSWORD@postgres:5432/gerenciamiento_viajes

# ngrok
NGROK_AUTHTOKEN=COLOCAR_TOKEN
# Compatibilidad con la configuración anterior: se usa si no se define
# NGROK_MINI_APP_DOMAIN.
NGROK_DOMAIN=COLOCAR_DOMINIO_NGROK
NGROK_MINI_APP_DOMAIN=
NGROK_ADMIN_DOMAIN=

# Telegram
TELEGRAM_BOT_TOKEN=COLOCAR_TOKEN
TELEGRAM_WEB_APP_URL=https://dominio.ngrok-free.app
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_GROUP_ID=tu id de grupo
TELEGRAM_GROUP_SUPRVISOR_ID=tu id del grupo de supervisores
TELEGRAM_SUPERVISOR_BOT_TOKEN=token del bot exclusivo de supervisores
TELEGRAM_SUPERVISOR_BOT_USERNAME=nombre del bot exclusivo de supervisores
TELEGRAM_BOT_USERNAME=tu nombre de bot
TELEGRAM_SUPERVISOR_WEB_APP_URL=https://dominio-supervision.ngrok-free.app
# En desarrollo queda desactivado para no competir con Render por el mismo
# token. Solo actívalo si Render está detenido o usas tokens de desarrollo.
TELEGRAM_POLLING_ENABLED=false
SUPERVISOR_REQUIRE_EMAIL_CONFIRMATION=false

# Correo de confirmación para supervisores (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# URL pública del API que recibe la confirmación, por ejemplo https://api.ejemplo.com/api/telegram/supervisor/confirmar-correo
SUPERVISOR_EMAIL_CONFIRM_URL=

#panel-admin
ADMIN_JWT_SECRET=PEGA_AQUI_EL_VALOR_GENERADO
ADMIN_JWT_EXPIRES_IN=8h
ADMIN_COOKIE_NAME=admin_session
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAME_SITE=lax
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_BLOCK_MINUTES=15

# Orígenes permitidos para llamadas web al backend (separados por coma).
# Déjalo vacío en desarrollo local; en Render usa las URLs de los dos sitios web.
CORS_ORIGINS=

# URL pública del backend, usada al compilar las dos interfaces en Render.
VITE_API_BASE_URL=

# Seguimiento GPS de la Mini App
VITE_GPS_TRACKING_INTERVAL_MS=30000
VITE_GPS_SYNC_BATCH_SIZE=100

# Azure AD (Microsoft Entra ID) & SharePoint
AZURE_TENANT_ID=
AZURE_CLIENT_ID=f107040e-8889-47bd-9a92-e9b66f1beb01
AZURE_CLIENT_SECRET=
AZURE_CLIENT_SECRET_ID=
AZURE_TENANT_DOMAIN=aspromex.com
# Puedes pegar directamente la URL completa de tu carpeta en SharePoint:
SHAREPOINT_URL=https://itzamnaoilandgas.sharepoint.com/sites/TecnologasdelaInformacin/Documentos%20compartidos/Forms/AllItems.aspx?id=%2Fsites%2FTecnologasdelaInformacin%2FDocumentos%20compartidos%2FDiagramas%20y%20Planos%2Ftest%5F1%5FGV
# O usar las variables individuales:
SHAREPOINT_SITE_ID=root
SHAREPOINT_FOLDER_PATH=Inspecciones


