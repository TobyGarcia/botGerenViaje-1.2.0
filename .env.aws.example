# ==============================================================================
# ARCHIVO DE PLANTILLA DE VARIABLES DE ENTORNO PARA PRODUCCIÓN EN AWS EC2
# Dominio asignado: gv.aspromex.mx
# Copia este archivo a `.env` en la instancia de EC2 antes de ejecutar Docker Compose
# ==============================================================================

# Entorno de Ejecución
NODE_ENV=production
TZ=America/Mexico_City

# Puertos Internos Expuestos a Nginx del Host (127.0.0.1)
BACKEND_PORT=3000
FRONTEND_PORT=8080
PANEL_ADMIN_PORT=8081
POSTGRES_PORT=5432

# PostgreSQL (Base de Datos)
POSTGRES_DB=gerenciamiento_viajes_prod
POSTGRES_USER=viajes_admin_prod
POSTGRES_PASSWORD=COLOCAR_CONTRASENA_POSTGRES_SEGURA_AQUI

# Cadena de Conexión de la Base de Datos para el Backend (Usa el nombre del contenedor 'postgres')
DATABASE_URL=postgresql://viajes_admin_prod:COLOCAR_CONTRASENA_POSTGRES_SEGURA_AQUI@postgres:5432/gerenciamiento_viajes_prod

# Bot de Telegram (Conductores)
TELEGRAM_BOT_TOKEN=COLOCAR_TOKEN_BOTFATHER
TELEGRAM_BOT_USERNAME=COLOCAR_USERNAME_BOT
TELEGRAM_WEB_APP_URL=https://gv.aspromex.mx/conductor
TELEGRAM_GROUP_ID=COLOCAR_ID_GRUPO_TELEGRAM
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600

# Bot de Telegram (Supervisores)
TELEGRAM_SUPERVISOR_BOT_TOKEN=COLOCAR_TOKEN_SUPERVISOR_BOT
TELEGRAM_SUPERVISOR_BOT_USERNAME=COLOCAR_USERNAME_SUPERVISOR_BOT
TELEGRAM_SUPERVISOR_WEB_APP_URL=https://gv.aspromex.mx/supervisor
TELEGRAM_GROUP_SUPRVISOR_ID=COLOCAR_ID_GRUPO_SUPERVISORES
SUPERVISOR_REQUIRE_EMAIL_CONFIRMATION=false

# Configuración de Seguridad para el Panel de Administración (Web)
ADMIN_JWT_SECRET=COLOCAR_HASH_ALEATORIO_Y_SEGURO_DE_ALTA_ENTROPIA
ADMIN_JWT_EXPIRES_IN=8h
ADMIN_COOKIE_NAME=admin_session
ADMIN_COOKIE_SECURE=true
ADMIN_COOKIE_SAME_SITE=lax
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_BLOCK_MINUTES=15

# Configuración de Servicio de Correo SMTP (Opcional - para supervisores)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPERVISOR_EMAIL_CONFIRM_URL=

# CORS y Variables de Build de VITE
# URLs de producción permitidas separadas por coma
CORS_ORIGINS=https://gv.aspromex.mx
VITE_API_BASE_URL=

# Parámetros de Rastreo GPS
VITE_GPS_TRACKING_INTERVAL_MS=30000
VITE_GPS_SYNC_BATCH_SIZE=100
