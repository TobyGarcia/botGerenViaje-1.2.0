# Copiar a .env.monitor privado. No usa tokens/grupos operativos por defecto.
AUDIT_TELEGRAM_ENABLED=false
AUDIT_TELEGRAM_BOT_TOKEN=
AUDIT_TELEGRAM_CHAT_ID=
# 0 representa el tema General nativo. Otros temas: message_thread_id positivo, distinto.
AUDIT_TELEGRAM_TOPIC_GENERAL=0
AUDIT_TELEGRAM_TOPIC_WARN=
AUDIT_TELEGRAM_TOPIC_ERROR=
AUDIT_TELEGRAM_TOPIC_CRITICAL=
AUDIT_ENVIRONMENT=local
SERVICE_MONITOR_ENABLED=false
MONITOR_STATE_FILE=/state/monitor.json
# Reemplazar las URLs por las del entorno que se desea comprobar.
MONITOR_TARGETS_JSON=[{"name":"backend","kind":"backend","url":"http://backend:3000/health"},{"name":"pwa","kind":"http","url":"http://frontend/"},{"name":"panel","kind":"http","url":"http://panel-admin/"}]
